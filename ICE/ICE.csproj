<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

	<PropertyGroup>
		<Version>0.0.78.15000</Version>
		<Description>Who said we couldn't explore the moon!.</Description>
		<PackageProjectUrl>https://github.com/goatcorp/ICE</PackageProjectUrl>
		<PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
		<IsPackable>true</IsPackable>
		<RootNamespace>ICE</RootNamespace>
		<TargetFramework>net10.0-windows8.0</TargetFramework>
		<InformationalVersion>$([System.DateTime]::UtcNow.ToString("yyyy\-MM\-dd HH\:mm\:ss"))</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<NoWarn>CS8618; CS8625; CS8629; </NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<OutputPath>bin\$(Configuration)\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<DalamudLibPath Condition="Exists('$(appdata)\\XIVLauncherCN\\addon\\Hooks\\dev\\')">$(appdata)\XIVLauncherCN\addon\Hooks\dev\</DalamudLibPath>
		<AssemblySearchPaths Condition="Exists('$(DalamudLibPath)')">$(AssemblySearchPaths);$(DalamudLibPath)</AssemblySearchPaths>
	</PropertyGroup>

	<Target Name="RestoreLocalization" BeforeTargets="BeforeCompile" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<Exec Command='powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\Build\RestoreLocalization.ps1" -ProjectDir "$(MSBuildProjectDirectory)"' />
	</Target>

	<ItemGroup>
		<Content Include="ICE.json" />
		<EmbeddedResource Include="Resources\Auxesia.png" />
		<EmbeddedResource Include="Resources\ResearchIcons\advance.png" />
		<EmbeddedResource Include="Resources\ResearchIcons\expert.png" />
		<EmbeddedResource Include="Resources\ResearchIcons\novice.png" />
		<EmbeddedResource Include="Resources\ResearchIcons\intermediate.png" />
		<EmbeddedResource Include="Resources\CosmicClassTracker.png" />
		<EmbeddedResource Include="Resources\Red_Alert.png" />
		<EmbeddedResource Include="Resources\Oizys.png" />
		<Content Include="utilities\Z_RandomNotes.yaml" />
		<EmbeddedResource Include="Resources\GreyscaleJobs\ALC.png" />
		<EmbeddedResource Include="Resources\GreyscaleJobs\ARM.png" />
		<EmbeddedResource Include="Resources\GreyscaleJobs\BSM.png" />
		<EmbeddedResource Include="Resources\GreyscaleJobs\BTN.png" />
		<EmbeddedResource Include="Resources\GreyscaleJobs\CUL.png" />
		<EmbeddedResource Include="Resources\GreyscaleJobs\FSH.png" />
		<EmbeddedResource Include="Resources\GreyscaleJobs\GSM.png" />
		<EmbeddedResource Include="Resources\GreyscaleJobs\LTW.png" />
		<EmbeddedResource Include="Resources\GreyscaleJobs\MIN.png" />
		<EmbeddedResource Include="Resources\GreyscaleJobs\WVR.png" />
		<EmbeddedResource Include="Resources\GreyscaleJobs\CRP.png" />
		<EmbeddedResource Include="Resources\Icon.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="Sounds\Task_Completed.mp3" />
		<EmbeddedResource Include="Resources\Phaenna.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources\Sinus_Ardorum.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources\GatherRoutes\**\*" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\MissionScores.csv" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ECommons" Version="3.2.1.9" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="Pictomancy" Version="1.0.9" />
		<PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OtterGui\OtterGui.csproj" />
		<ProjectReference Include="..\Glamourer.Api\Glamourer.Api.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Update="DalamudPackager" Version="15.0.0" />
		<PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.2" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Resources\GatherRoutes\" />
	  <Folder Include="Ui\NewFolder\" />
	</ItemGroup>

	<!-- OtterGui depends on nested submodule OtterGuiInternal; init recursively if missing -->
	<Target Name="EnsureOtterGuiSubmodules" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildThisFileDirectory)..\OtterGui\OtterGuiInternal\OtterGuiInternal.csproj')">
		<Exec Command="git submodule update --init --recursive OtterGui" WorkingDirectory="$(MSBuildThisFileDirectory).." />
	</Target>
</Project>
